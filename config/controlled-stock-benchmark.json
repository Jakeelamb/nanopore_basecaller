    "required_gpu_fields": ["utilization.gpu", "memory.used", "power.draw", "temperature.gpu", "clocks.sm"],
    "cooldown": {
      "max_temperature_celsius": 40,
      "max_utilization_percent": 5,
      "consecutive_samples": 3,
      "interval_seconds": 1,
      "timeout_seconds": 600
    }
  }
